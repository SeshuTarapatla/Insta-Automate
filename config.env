# Flow Trigger Switches : {0: OFF, 1: ON},
# Flow Trigger Queues  : {comma separated entities}

ENTITY_INGEST=1
ENTITY_SCAN=1
ENTITY_CLASSIFY=1
ENTITY_SCRAPE=1
ENTITY_FOLLOW=0
ENTITY_QUEUE=''

# Limits : see insta_automate.models.meta.Limit for fallback defaults.
# Edit and save - flows pick up new values live, no rebuild/restart needed
# (except PROFILES/REELS/POSTS, which only bound Scan's schema and aren't
# the live enforcement point - see Scan.limit_reached).

PROFILES=10
REELS=30
POSTS=30
SCRAPE=300
SCRAPE_BATCH=10
FOLLOW=60
FOLLOW_BATCH=5
FMIN=100
FMAX=2000
