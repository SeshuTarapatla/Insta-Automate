# Flow Trigger Switches : {0: OFF, 1: ON},
# Flow Trigger Queues  : {comma separated entities}

ENTITY_INGEST=1
ENTITY_SCAN=1
ENTITY_CLASSIFY=1
ENTITY_SCRAPE=1
ENTITY_FOLLOW=0
ENTITY_QUEUE=''

# Limits : see insta_automate.models.meta.Config for fallback defaults.
# Edit and save - flows pick up new values live, no rebuild/restart needed.
# PROFILES/REELS/POSTS ARE the live daily scan caps: Scan.limit_reached compares
# today's counts against them and the entity_scan trigger loop pauses at the
# limit until the next day (Q3, answered - this comment used to say otherwise).

PROFILES=10
REELS=30
POSTS=30
SCRAPE=300
SCRAPE_BATCH=10
FOLLOW=60
FOLLOW_BATCH=5
FMIN=100
FMAX=2000
